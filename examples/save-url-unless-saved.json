            "mode": "name",
            "value": "Read Later"
          },
          "tags": "chat"
        },
        "options": {
          "onDuplicate": "returnExisting"
        }
      },
      "id": "7417bb18-8057-5fba-98a5-4305ac7dbfd3",
      "name": "Create link",
